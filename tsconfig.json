{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "useDefineForClassFields": false,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "moduleResolution": "node",
    "declaration": true,
    "outDir": "./dist",
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["index.ts", "decorators/**/*", "cache/**/*", "logger/**/*", "tests/**/*"]
}